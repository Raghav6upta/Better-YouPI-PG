# Optional local defaults for the dashboard-managed Amazon Pay setup.
# Copy to .env.amazon-local. Real secrets are generated under data/.secrets/.
NODE_ENV=development
YOUPI_MODE=localhost
SQLITE_DB_PATH=./data/youpi_pg.sqlite
YOUPI_EXPOSE_DEV_OTP=false
BASE_PAYMENT_API_URL=http://127.0.0.1:6100
BASE_CHECKOUT_URL=http://127.0.0.1:7000
# Prevent the supervisor from starting legacy Gmail/SMS observers during setup.
AMAZON_PAY_ENABLED=true
AMAZON_PAY_DASHBOARD_MANAGED=true
# Remain observe-only until explicitly enabled in the dashboard.
AMAZON_PAY_DRY_RUN=true
AMAZON_PAY_MATCHING_MODE=observe
